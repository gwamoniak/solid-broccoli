        Property { name: "mode"; type: "int" }
        Property { name: "hold"; type: "bool" }
        Property { name: "hasDark"; type: "bool"; isReadonly: true }
        Property { name: "hasReference"; type: "bool"; isReadonly: true }
        Property { name: "smoothingWindow"; type: "int" }
        Property { name: "integrationFromNm"; type: "double"; isReadonly: true }
