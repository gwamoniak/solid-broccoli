        Property { name: "mirrorPreview"; type: "bool" }
        Property { name: "spectrumOverlay"; type: "bool" }
        Property { name: "geigerTubeFactor"; type: "double" }
        Property { name: "geigerAlertThreshold"; type: "double" }
        Property { name: "objectDetection"; type: "bool" }
        Property { name: "detectionModelPath"; type: "QString"; isReadonly: true }
        Property { name: "detectionModelName"; type: "QString"; isReadonly: true }
        Property { name: "detectionStride"; type: "int" }
        Property { name: "aiModelPath"; type: "QString"; isReadonly: true }
        Property { name: "aiModelName"; type: "QString"; isReadonly: true }
        Method { name: "importDetectionModel"; type: "bool"; Parameter { name: "source"; type: "QUrl" } }
        Method { name: "revealModelsDir" }
        Method { name: "setAiModelFromUrl"; Parameter { name: "source"; type: "QUrl" } }
    }

    Component {
        name: "CameraService"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["solid.broccoli/CameraService 1.0"]
        isSingleton: true
        Property { name: "availableCameras"; type: "QStringList"; isReadonly: true }
        Property { name: "currentCameraIndex"; type: "int" }
        Property { name: "availableFormats"; type: "QStringList"; isReadonly: true }
        Property { name: "currentFormatIndex"; type: "int" }
        Property { name: "active"; type: "bool"; isReadonly: true }
        Property { name: "recording"; type: "bool"; isReadonly: true }
        Property { name: "recordingDuration"; type: "QString"; isReadonly: true }
        Signal { name: "imageSaved"; Parameter { name: "filePath"; type: "QString" } }
        Signal { name: "captureError"; Parameter { name: "message"; type: "QString" } }
        Method { name: "attachVideoOutput"; Parameter { name: "videoOutput"; type: "QObject"; isPointer: true } }
        Method { name: "setActive"; Parameter { name: "active"; type: "bool" } }
        Method { name: "captureImage" }
        Method { name: "startRecording" }
        Method { name: "stopRecording" }
    }

    Component {
