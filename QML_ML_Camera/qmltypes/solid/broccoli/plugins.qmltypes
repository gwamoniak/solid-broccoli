import QtQuick.tooling 1.2

// Tooling-only description of the instances registered by main.cpp. Keeping
// this beside the source module gives qmllint and IDE completion the same
// public surface that QML receives at runtime without creating a second plugin
// or a second set of singleton objects.
Module {
    Component {
        name: "AppContext"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["solid.broccoli/AppContext 1.0"]
        isSingleton: true
        Property { name: "albumModel"; type: "AlbumModel"; isPointer: true; isReadonly: true }
        Property { name: "pictureModel"; type: "PictureModel"; isPointer: true; isReadonly: true }
        Property { name: "movieModel"; type: "MovieModel"; isPointer: true; isReadonly: true }
        Property { name: "loggerModel"; type: "LoggerModel"; isPointer: true; isReadonly: true }
        Property { name: "sessionModel"; type: "SessionModel"; isPointer: true; isReadonly: true }
        Property { name: "sessionSpectrumModel"; type: "SessionSpectrumModel"; isPointer: true; isReadonly: true }
        Property { name: "pluginModel"; type: "PluginManager"; isPointer: true; isReadonly: true }
        Property { name: "captureCoordinator"; type: "CaptureCoordinator"; isPointer: true; isReadonly: true }
        Property { name: "detectionModel"; type: "DetectionModel"; isPointer: true; isReadonly: true }
        Property { name: "reportService"; type: "QVariant"; isReadonly: true }
        Property { name: "logsUrl"; type: "QUrl"; isReadonly: true }
        Property { name: "thumbnailSize"; type: "int"; isReadonly: true }
        Property { name: "visionAvailable"; type: "bool"; isReadonly: true }
        Property { name: "aiAvailable"; type: "bool"; isReadonly: true }
    }

    Component {
        name: "AppNotifier"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["solid.broccoli/AppNotifier 1.0"]
        isSingleton: true
        Enum { name: "Level"; values: ["Info", "Warning", "Error"] }
        Property { name: "message"; type: "QString"; isReadonly: true }
        Property { name: "level"; type: "Level"; isReadonly: true }
        Property { name: "revision"; type: "quint64"; isReadonly: true }
        Signal { name: "notificationChanged" }
        Method { name: "showInfo"; Parameter { name: "message"; type: "QString" } }
        Method { name: "showWarning"; Parameter { name: "message"; type: "QString" } }
        Method { name: "showError"; Parameter { name: "message"; type: "QString" } }
    }

    Component {
        name: "HelpContent"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["solid.broccoli/HelpContent 1.0"]
        isSingleton: true
        Property { name: "markdown"; type: "QString"; isReadonly: true }
    }

    Component {
        name: "AppSettings"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["solid.broccoli/AppSettings 1.0"]
