        Method { name: "clearOverlays" }
        Method { name: "exportCapture"; type: "bool"; Parameter { name: "spectrumId"; type: "int" } }
    }

    Component {
        name: "GeigerService"
        accessSemantics: "reference"
        prototype: "QObject"
        exports: ["solid.broccoli/GeigerService 1.0"]
