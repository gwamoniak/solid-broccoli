        Property { name: "alertThreshold"; type: "double" }
        Method { name: "selectNextDevice" }
        Method { name: "connectDevice"; type: "bool" }
        Method { name: "disconnectDevice" }
        Method { name: "startAcquisition" }
        Method { name: "stopAcquisition" }
        Method { name: "saveMeasurement"; Parameter { name: "name"; type: "QString" }
        Parameter { name: "tags"; type: "QString" } }
        Method { name: "exportWindowCsv"; type: "bool" }
    }

    Component {
        name: "SpectrumView"
        accessSemantics: "reference"
        prototype: "QQuickItem"
        exports: ["solid.broccoli/SpectrumView 1.0"]
