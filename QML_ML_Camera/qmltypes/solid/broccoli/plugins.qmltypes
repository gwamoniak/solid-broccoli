        Property { name: "hasIntegrationRegion"; type: "bool"; isReadonly: true }
        Property { name: "integralValue"; type: "double"; isReadonly: true }
        Property { name: "peakModel"; type: "QVariant"; isReadonly: true }
        Property { name: "overlayIds"; type: "QVariantList"; isReadonly: true }
        Method { name: "refreshDevices" }
        Method { name: "selectNextDevice" }
        Method { name: "connectDevice"; type: "bool" }
        Method { name: "disconnectDevice" }
        Method { name: "startAcquisition" }
        Method { name: "stopAcquisition" }
