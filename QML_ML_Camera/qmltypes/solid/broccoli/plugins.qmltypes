        Property { name: "maxWavelength"; type: "double"; isReadonly: true }
        Property { name: "yMax"; type: "double"; isReadonly: true }
        Property { name: "autoScaleY"; type: "bool" }
        Property { name: "xAxisTitle"; type: "QString" }
        Property { name: "xTickStep"; type: "double" }
        Property { name: "showReference"; type: "bool" }
        Property { name: "showDark"; type: "bool" }
        Property { name: "tickWavelengths"; type: "QVariantList"; isReadonly: true }
        Property { name: "gridColor"; type: "QColor" }
        Property { name: "axisColor"; type: "QColor" }
        Property { name: "traceColor"; type: "QColor" }
        Property { name: "referenceColor"; type: "QColor" }
        Property { name: "darkTraceColor"; type: "QColor" }
        Property { name: "regionColor"; type: "QColor" }
        Property { name: "overlayColor1"; type: "QColor" }
